# 开发环境配置（vite dev / build --mode development 时加载）
# 注：NODE_ENV 由 Vite 根据 mode 自动设置，无需在此声明。

# 后端接口基础地址。
# 使用相对前缀 /api，依赖 vite.config.ts 中的开发代理把 /api 转发到后端 localhost:8080，
# 从而避免浏览器跨域（前端 5173 → 后端 8080）。
VITE_API_BASE_URL='/api'

# 开发代理目标（仅作说明，实际转发规则在 vite.config.ts 的 server.proxy 中配置）
# 代理：/api -> http://localhost:8080
